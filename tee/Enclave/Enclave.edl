enclave {
    from "sgx_tstdc.edl" import *;
    include "sgx_tseal.h"

    trusted {

        public sgx_status_t enclave_init_env(
            [out, size=sealed_size] sgx_sealed_data_t* sealed_data,
            uint32_t sealed_size
        );

        public sgx_status_t enclave_set_workday(
            [in, size=7] uint8_t* workday_arr
        );

        public sgx_status_t enclave_set_timewindow(
            int start_min,
            int end_min
        );

        public sgx_status_t enclave_set_subnet(
            [in, string] const char* name,
            uint32_t network,
            uint32_t mask
        );

        public sgx_status_t enclave_seal_env(
            [out, size=sealed_size] sgx_sealed_data_t* sealed_data,
            uint32_t sealed_size
        );

        public sgx_status_t enclave_unseal_env(
            [in, size=sealed_size] const sgx_sealed_data_t* sealed_data,
            uint32_t sealed_size
        );

        public sgx_status_t enclave_get_sealed_size(
            [out] uint32_t* sealed_size
        );

        public sgx_status_t enclave_subnet_exists(
            [in, string] const char* name,
            [out] int* exists
        );

        public sgx_status_t enclave_check_env(
            int day_of_week,
            int current_minute,
            uint32_t client_ip,
            [in, string] const char* subnet_name,
            int workday_value,
            int worktime_value,
            int check_workday,
            int check_worktime,
            int check_subnet,
            [out] int* result
        );
        
        public sgx_status_t enclave_grant_admin_priv(
            uint32_t role_oid,
            uint32_t priv_mask
        );

        public sgx_status_t enclave_revoke_admin_priv(
            uint32_t role_oid,
            uint32_t priv_mask
        );

        public sgx_status_t enclave_check_admin_priv(
            uint32_t role_oid,
            uint32_t priv_mask,
            [out] int* has_priv
        );
        
        public sgx_status_t enclave_debug_dump_env();

    };

    untrusted {
        void ocall_print([in, string] const char *str);
    };
};
